// Cloudflare deployment settings. "assets" tells Cloudflare to serve the built site in ./dist.
// There is no server code: every visitor request is answered with a static file.
{
  "name": "plett-lagoon-estate",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Required by Cloudflare's branch preview command ("wrangler preview"). Empty means: use the settings above.
  "previews": {}
}
