---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { getDocuments } from '../lib/documents';
import hero from '../assets/hero/daytime-land-lagoon-mouth.jpg';

const documents = getDocuments();
---

<Layout title="Documents" description="Download the estate rules, building rules and plots masterplan.">
  <PageHero title="Documents" intro="Download the current rules and plans." image={hero} />

  <section class="band">
    <div class="wrap">
      <p class="lede" style="margin-bottom:clamp(28px,4vw,48px)">
        The date under each download shows when the document was last updated.
      </p>
      <ul class="docs">
        {
          documents.map((doc) => (
            <li class="doc">
              <div>
                <h2 class="h-md">{doc.title}</h2>
                <p class="muted" style="margin-top:6px">{doc.description}</p>
              </div>
              <div class="doc__action">
                <a href={doc.url} download class="btn">Download</a>
                <p class="doc__meta">Updated {doc.updatedLabel} · PDF, {doc.sizeLabel}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
