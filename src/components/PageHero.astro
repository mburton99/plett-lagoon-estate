---
// Shorter cover at the top of every page except Home.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  intro?: string;
  image: ImageMetadata;
}
const { title, intro, image } = Astro.props;
---

<section class="page-hero">
  <div class="hero__media">
    <Image src={image} alt="" width={1088} loading="eager" />
  </div>
  <div class="hero__shade"></div>
  <div class="wrap page-hero__inner">
    <h1 class="rise">{title}</h1>
    {intro && <p class="rise rise--2">{intro}</p>}
  </div>
</section>
