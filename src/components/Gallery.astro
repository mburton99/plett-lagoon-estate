---
// The photo gallery: a grid of thumbnails that open in a viewer (lightbox) on click.
// Without JavaScript, each thumbnail is simply a link to the larger photo.
import { Picture, getImage } from 'astro:assets';
import { getGallery } from '../lib/gallery';

const items = getGallery();

// One larger version of each photo for the viewer (never bigger than the original).
const large = await Promise.all(
  items.map((item) => getImage({ src: item.image, width: Math.min(2000, item.image.width), format: 'webp', quality: 80 })),
);
---

{
  items.length === 0 ? (
    <p class="text-black/70">Photos coming soon.</p>
  ) : (
    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item, i) => (
        <li>
          <figure>
            <a
              href={large[i].src}
              data-lightbox
              data-alt={item.alt}
              data-caption={item.caption ?? ''}
              data-impression={item.impression ? 'true' : 'false'}
              class="relative block overflow-hidden bg-black/5 focus-visible:outline-2 focus-visible:outline-offset-2"
            >
              <Picture
                src={item.image}
                alt={item.alt}
                widths={[480, 800, 1200]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                loading="lazy"
                decoding="async"
                class="block aspect-[3/2] w-full object-cover"
              />
              {item.impression && (
                <span class="absolute bottom-2 left-2 rounded bg-black/65 px-2 py-1 text-xs text-white">
                  Architect's impression
                </span>
              )}
            </a>
            {item.caption && <figcaption class="mt-2 text-sm text-black/60">{item.caption}</figcaption>}
          </figure>
        </li>
      ))}
    </ul>
  )
}

<dialog
  id="lightbox"
  aria-label="Photo viewer"
  class="fixed inset-0 m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 text-white backdrop:bg-black/95"
>
  <div class="flex h-full w-full flex-col items-center justify-center gap-3 p-4 sm:p-10">
    <button
      type="button"
      data-lb-close
      aria-label="Close photo viewer"
      class="absolute top-3 right-3 rounded-full bg-white/15 px-4 py-2 text-sm hover:bg-white/30 focus-visible:outline-2 focus-visible:outline-white"
    >
      Close
    </button>
    <img data-lb-img src="" alt="" class="max-h-[78vh] max-w-full object-contain" />
    <p data-lb-caption class="min-h-6 max-w-2xl text-center text-sm text-white/80"></p>
    <div class="flex items-center gap-6">
      <button
        type="button"
        data-lb-prev
        aria-label="Previous photo"
        class="rounded-full bg-white/15 px-5 py-2 hover:bg-white/30 focus-visible:outline-2 focus-visible:outline-white"
      >
        Previous
      </button>
      <span data-lb-count aria-live="polite" class="min-w-14 text-center text-sm text-white/70"></span>
      <button
        type="button"
        data-lb-next
        aria-label="Next photo"
        class="rounded-full bg-white/15 px-5 py-2 hover:bg-white/30 focus-visible:outline-2 focus-visible:outline-white"
      >
        Next
      </button>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#lightbox');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]'));

  if (dialog && links.length > 0) {
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
    let index = 0;
    let opener: HTMLElement | null = null;

    const preload = (i: number) => {
      const href = links[(i + links.length) % links.length].href;
      new Image().src = href;
    };

    const show = (i: number) => {
      index = (i + links.length) % links.length;
      const link = links[index];
      img.src = link.href;
      img.alt = link.dataset.alt ?? '';
      caption.textContent = [link.dataset.caption, link.dataset.impression === 'true' ? "Architect's impression" : '']
        .filter(Boolean)
        .join(' · ');
      count.textContent = `${index + 1} / ${links.length}`;
      preload(index + 1);
      preload(index - 1);
    };

    links.forEach((link, i) => {
      link.addEventListener('click', (event) => {
        // Let "open in new tab" style clicks behave normally.
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
        event.preventDefault();
        opener = link;
        show(i);
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => show(index + 1));

    // Clicking the dark area around the photo closes the viewer.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog || (event.target as HTMLElement).parentElement === dialog) dialog.close();
    });

    // Escape closes the viewer by itself (built into <dialog>). Arrow keys move between photos.
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });

    // Swipe left or right on a phone.
    let startX = 0;
    dialog.addEventListener('touchstart', (event) => (startX = event.changedTouches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (event) => {
      const dx = event.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(dx < 0 ? index + 1 : index - 1);
    });

    // Put keyboard focus back where it was when the viewer closes.
    dialog.addEventListener('close', () => {
      img.src = '';
      opener?.focus();
    });
  }
</script>
